# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored — never commit real credentials.

# --- Required from Step 1 (infrastructure proof) ---
# Supabase Postgres connection string (Transaction pooler, port 6543)
DATABASE_URL=postgresql://user:password@host:5432/postgres
# Upstash Redis REST URL and token (Celery broker)
REDIS_URL=https://xxx.upstash.io
UPSTASH_TOKEN=
# Optional: explicit Celery broker URL (Upstash "Redis" endpoint, rediss://).
# When unset, the worker derives rediss:// from REDIS_URL + UPSTASH_TOKEN.
CELERY_BROKER_URL=

# --- Required from Step 2/3 (auth + GitHub) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
GITHUB_SCOPE=repo
# Dir on the server's own disk where shallow clones land (Step 3)
CLONE_ROOT_DIR=./.clones

# --- Step 7 (code chunking + embeddings) ---
# All optional: the defaults below are what Step 7 ships with. The model
# (jinaai/jina-embeddings-v2-base-code, ~600MB) downloads from the HuggingFace
# Hub on first use and is cached in the OS/HF cache; set HF_HUB_OFFLINE=1 to
# forbid that download.
EMBEDDING_ENABLED=true
EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-code
EMBEDDING_BATCH_SIZE=16
# Token cap per chunk — the model's *trained* context, and the single biggest
# cost lever. Measured on an i5-1235U: a flat ~191 tok/s of padded input, with
# a long-tailed chunk distribution (median 152 tok, p90 645, max 3458), so at
# 2048 the one batch of longest chunks was ~70% of a repo's embed time. At 512
# it is ~6.8x cheaper and 69 of 77 demo chunks are unaffected. Raising this
# only re-truncates those long chunks into the vector; the stored `content`
# is verbatim either way.
EMBEDDING_MAX_SEQ_LENGTH=512
# CPU threads for the embed pass. Unset = torch's default (one per logical
# processor), which oversubscribes hybrid 2P+8E CPUs. Set it to a measured
# value for your machine; see AGENTS.md for the measured table.
# EMBEDDING_TORCH_THREADS=4

# --- Required from Step 9 (AI chat) ---
LLM_PROVIDER=groq
GROQ_API_KEY=

# --- Required from Step 13 (webhooks) ---
WEBHOOK_SECRET=

# --- Required from Step 18 (token encryption at rest) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
