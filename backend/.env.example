# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored — never commit real credentials.

# --- Required from Step 1 (infrastructure proof) ---
# Supabase Postgres connection string (Transaction pooler, port 6543)
DATABASE_URL=postgresql://user:password@host:5432/postgres
# Upstash Redis REST URL and token (Celery broker)
REDIS_URL=https://xxx.upstash.io
UPSTASH_TOKEN=
# Optional: explicit Celery broker URL (Upstash "Redis" endpoint, rediss://).
# When unset, the worker derives rediss:// from REDIS_URL + UPSTASH_TOKEN.
CELERY_BROKER_URL=

# --- Required from Step 2/3 (auth + GitHub) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
GITHUB_SCOPE=repo
# Dir on the server's own disk where shallow clones land (Step 3)
CLONE_ROOT_DIR=./.clones

# --- Step 7 (code chunking + embeddings) ---
# All optional: the defaults below are what Step 7 ships with. The model
# (jinaai/jina-embeddings-v2-base-code, ~600MB) downloads from the HuggingFace
# Hub on first use and is cached in the OS/HF cache; set HF_HUB_OFFLINE=1 to
# forbid that download.
EMBEDDING_ENABLED=true
EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-code
EMBEDDING_BATCH_SIZE=16
# Token cap per chunk. The model was trained at 512 and extrapolates to 8192;
# 2048 keeps a 120-line chunk intact while staying affordable on CPU.
EMBEDDING_MAX_SEQ_LENGTH=2048

# --- Required from Step 9 (AI chat) ---
LLM_PROVIDER=groq
GROQ_API_KEY=

# --- Required from Step 13 (webhooks) ---
WEBHOOK_SECRET=

# --- Required from Step 18 (token encryption at rest) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
