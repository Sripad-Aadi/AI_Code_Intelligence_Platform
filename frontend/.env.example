# Copy this file to `frontend/.env` and fill in your values.
# All VITE_ variables are embedded in the browser bundle at build time —
# only use values that are safe to expose (Supabase URL + anon/publishable key).
#
# The AI Platform backend runs on port 8000 by default.
VITE_API_BASE=http://localhost:8000

# Supabase project URL (bare project URL, e.g. https://<ref>.supabase.co).
# The anon key is the publishable key from the Supabase dashboard
# (Project Settings -> API). Leave both empty to use the "paste an access
# token" fallback on the login page instead of email/password auth.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=